# Env files that have secrets inside
.env
.env.hard

# PHPStorm dir
.idea/

# Python cache
compose/wrapper/__pycache__

# Config and 3rd-party packages
custom/public/application/config.ini
custom/public/vendor/

# Uploads
custom/public/data/upload/

# Other files to me ignored
custom/**/*.gz
custom/**/*.mo
custom/**/*.log
custom/**/*.pem
custom/**/*.zip
custom/**/*.pdf
custom/**/*.tgz

# Temporary files
var/tmp/*

# Restart scenario
var/restart

# MySQL-to-SQL Server conversion state
.convert.sqlserver

# Any stderr files
*.stderr

# Any PID and log files
*.pid
*.log
